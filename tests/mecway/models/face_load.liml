<liml version="33">
  <analysis type="S30" />
  <incompatiblehex8>true</incompatiblehex8>
  <node nid="1" x="0" y="0" z="0" />
  <node nid="2" x="0.25" y="0" z="0" />
  <node nid="3" x="0.5" y="0" z="0" />
  <node nid="4" x="0.75" y="0" z="0" />
  <node nid="5" x="1" y="0" z="0" />
  <elset name="E_Rect" colorrgb="DADADA" material="Rect">
    <elem eid="1" shape="line2" nodes="1 2" />
    <elem eid="2" shape="line2" nodes="2 3" />
    <elem eid="3" shape="line2" nodes="3 4" />
    <elem eid="4" shape="line2" nodes="4 5" />
  </elset>
  <linepressure selection="q0_face"><x>120.0 N/m</x><y>-1000.0 N/m</y><z>700.0 N/m</z></linepressure>
  <fixed selection="clamp" />
  <mat name="Rect">
    <geometric type="RectBar" recta="100 mm" rectb="50 mm" pointy="10 mm" pointz="5 mm" />
    <mechanical type="Isotropic" youngsmodulus="210 GPa" poissonratio="0.3" />
  </mat>
  <faceselection name="q0_face" direct="true"><face eid="1" faceid="1" /><face eid="2" faceid="1" /><face eid="3" faceid="1" /><face eid="4" faceid="1" /></faceselection>
  <nodeselection name="clamp" direct="true"><node nid="1" /></nodeselection>
  <fieldvariable name="displacement" displayunit="m" />
  <fieldvariable name="rotation" displayunit="rad" />
  <fieldvariable name="reaction force" displayunit="N" />
  <fieldvariable name="reaction moment" displayunit="N.m" />
  <fieldvariable name="stress in element coordinates" displayunit="Pa" />
  <fieldvariable name="tensile force" displayunit="N" />
  <fieldvariable name="shear force" displayunit="N" />
  <fieldvariable name="torsion moment" displayunit="N.m" />
  <fieldvariable name="bending moment 2" displayunit="N.m" />
</liml>
